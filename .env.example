# TradingView WebSocket Auth Token (REQUIRED)
# Get this from your TradingView account
TVWS_AUTH_TOKEN=your_tradingview_auth_token_here

# API Security (REQUIRED)
# Generate a secure random string for API authentication
API_KEY=your_secure_api_key_here

# Server Configuration
NODE_ENV=development
PORT=3001

# CORS (comma-separated origins)
# For development: http://localhost:3000,http://localhost:3001
# For production: https://yourdomain.com
ALLOWED_ORIGINS=*
