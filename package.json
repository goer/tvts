{
  "name": "tvts",
  "version": "1.0.0",
  "description": "TypeScript library for TradingView data with REST API - yfinance-like API for WebSocket streaming",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:api": "npm run tsoa:spec && npm run tsoa:routes && npm run build",
    "tsoa:spec": "tsoa spec",
    "tsoa:routes": "tsoa routes",
    "dev": "tsc --watch",
    "dev:api": "nodemon --watch api --ext ts --exec \"npm run build:api && node dist/api/server.js\"",
    "start:api": "node dist/api/server.js",
    "clean": "rm -rf dist build",
    "vercel:dev": "vercel dev",
    "vercel:deploy": "vercel --prod"
  },
  "keywords": [
    "tradingview",
    "websocket",
    "stock-data",
    "ohlcv",
    "real-time",
    "typescript",
    "api",
    "rest",
    "express",
    "openapi",
    "swagger"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.0",
    "tsoa": "^6.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/swagger-ui-express": "^4.1.6",
    "typescript": "^5.3.0",
    "nodemon": "^3.1.0",
    "vercel": "^37.0.0"
  }
}
