{
  "name": "tvts",
  "version": "1.0.0",
  "description": "TypeScript library for TradingView data - yfinance-like API for WebSocket streaming",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "tvts": "./dist/cli.js"
  },
  "scripts": {
    "build:local": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "start:server": "npm run build:local && node dist/server.js"
  },
  "keywords": [
    "tradingview",
    "websocket",
    "stock-data",
    "ohlcv",
    "real-time",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/commander": "^2.12.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0"
  }
}